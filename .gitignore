# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-store/

# Testing
/coverage
.nyc_output/

# Build outputs
/.next/
/out/
/dist/
/build/
.next/
.cache/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE and editor files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# System Files
.DS_Store
Thumbs.db

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Database
data/*.db
data/*.db-journal
data/*.db-wal

# User configuration and sensitive data
config.user*
config.user.backup*.json
config.json*
config/*.json
!config/default.json
!config/example.json

# Application data
data/optimizer-jobs.json
data/logs/

# Local development
.local-*
.venv/

# Build analyzer
.next/analyze/

# Optional package manager specific files
package-lock.json
pnpm-lock.yaml
yarn.lock

# Optional next.js telemetry
.next/cache/

# Optional production build files
.next/server/
.next/cache/
.next/standalone/

# Optional test files
__tests__/__mocks__/
__tests__/__snapshots__/
*.test.ts.snap

# Optional cypress
cypress/
cypress/videos/
cypress/screenshots/

# Optional playwright
playwright-report/
test-results/

# Optional storybook
.storybook/

# Optional parcel-bundler cache
.cache/
.parcel-cache/

# Optional Windows image file caches
Thumbs.db
ehthumbs.db

# Optional Windows shortcuts
*.lnk

# Windsurf
.windsurf/
.windsurf/*
!.windsurf/workflows/
.windsurf/cache/
.windsurf/logs/
.windsurf/tmp/
.windsurf/debug/
*.windsurf.log
